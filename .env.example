# ===== App =====
APP_ENV=production
APP_URL=https://your-service.onrender.com
APP_NAME="AF MONEY SAFER"
APP_SECRET=            # 64+ random hex chars (HMAC for OTP/CSRF). openssl rand -hex 32
CLIENT_IP_HEADER=CF-Connecting-IP   # header carrying the real client IP behind Render; verify in your logs
SESSION_LIFETIME_MIN=60
MAINTENANCE_MODE=false

# ===== Firebase (Admin SDK = server only) =====
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=                 # used server-side only for Auth REST signInWithPassword
FIREBASE_SERVICE_ACCOUNT_JSON_B64=    # whole service-account JSON pasted as-is, OR its base64 (never commit the file)

# ===== TashPay (values come from your TashPay account manager) =====
TASHPAY_BASE_URL=https://api.tashpay.org/api
TASHPAY_ACCOUNT=
TASHPAY_API_KEY=
TASHPAY_DEPOSIT_NOTIFY_URL=${APP_URL}/api/deposit/notify.php
TASHPAY_WITHDRAW_NOTIFY_URL=${APP_URL}/api/withdraw/notify.php
TASHPAY_CALLBACK_IPS=43.98.164.189,43.98.196.171
TASHPAY_ENFORCE_CALLBACK_IP=false      # true = reject callbacks from other IPs (signature is checked either way)

# ===== Cloudflare Turnstile =====
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ===== SMTP =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="AF MONEY SAFER"

# ===== Defaults (admin panel can override via Firestore settings/app) =====
MIN_DEPOSIT=100
MAX_DEPOSIT=25000
MIN_WITHDRAW=100
MAX_WITHDRAW=25000
DEPOSIT_FEE_PERCENT=0
WITHDRAW_FEE_PERCENT=0
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ===== Cron =====
CRON_SECRET=           # shared secret for /api/cron/health.php and cron scripts
