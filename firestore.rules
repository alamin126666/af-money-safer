rules_version = '2';
// All data access goes through the PHP backend using the Firebase Admin SDK,
// which bypasses these rules. Browsers/mobile clients must never read or write
// Firestore directly, so every client-side operation is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
