{
  "name": "af/money-safer",
  "description": "AF MONEY SAFER - deposit & withdraw platform (PHP + Firestore + TashPay)",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-gd": "*",
    "ext-grpc": "*",
    "kreait/firebase-php": "^7.0",
    "google/cloud-firestore": "^1.40",
    "phpmailer/phpmailer": "^6.9",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": { "psr-4": { "App\\": "src/" } },
  "config": { "optimize-autoloader": true, "sort-packages": true }
}
